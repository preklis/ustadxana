# --- Database ---
DATABASE_URL="postgresql://ustadxana:ustadxana@localhost:5432/ustadxana?schema=public"

# --- App ---
APP_URL="http://localhost:3000"
# Set to "true" only when served over HTTPS (secure cookies)
COOKIE_SECURE="false"

# --- First superadmin (created by `npm run db:seed`) ---
SUPERADMIN_EMAIL="nizami@example.com"
SUPERADMIN_PASSWORD="ChangeMe123!"
