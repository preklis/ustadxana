SUPERADMIN_LAST_NAME="Taghizada"

# --- File uploads ---
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="50"

# --- Email (OTP codes etc). Leave empty to print emails to the server console. ---
# Google account (Gmail or Workspace) + its 16-letter App Password
SMTP_USER=""
SMTP_PASSWORD=""

# Optional: restrict student registration to these email domains (comma separated). Empty = any.
ALLOWED_EMAIL_DOMAINS=""
